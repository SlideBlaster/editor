{
  "name": "slideblaster-web-host",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/gen-katex-css.mjs && node build.mjs",
    "build:wasm": "../../scripts/build-wasm.sh",
    "serve": "../../scripts/serve-web.sh",
    "typecheck": "node scripts/gen-katex-css.mjs && tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:browser": "npm run build --silent && node test/browser-smoke-product2.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "linkedom": "0.18.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "katex": "0.16.22",
    "shiki": "4.0.2"
  }
}

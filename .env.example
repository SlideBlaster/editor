# Browser-git spike (Track 0) integration test. Copy to .env.local and fill in to
# run the live round-trip in packages/adapters-browser; unset, the test is skipped.
#
# A throwaway GitHub repo (the test pushes to it) and a fine-grained PAT scoped to
# ONLY that repo with Contents: read/write. The PAT stands in for the App-minted
# token that the Auth service will issue at M4.
SB_GIT_SPIKE_REPO=https://github.com/your-org/scratch-repo.git
SB_GIT_SPIKE_TOKEN=github_pat_xxx

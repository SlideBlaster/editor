# Browser-git spike (Track 0) integration test. Copy to .env.local and fill in to
# run the live round-trip in packages/adapters-browser; unset, the test is skipped.
#
# A throwaway GitHub repo (the test pushes to it) and a fine-grained PAT scoped to
# ONLY that repo with Contents: read/write. The PAT stands in for the App-minted
# token that the Auth service will issue at M4.
SB_GIT_SPIKE_REPO=https://github.com/your-org/scratch-repo.git
SB_GIT_SPIKE_TOKEN=github_pat_xxx

# M4 auth (web-shell). Point the shell at the Auth service to enable GitHub
# sign-in + repo sync. Unset -> DevAuthAdapter (offline; instant local identity).
#
# Local dev (Phase A): run the auth-stub and use the same-origin Vite proxy —
#   pnpm --filter @slideblaster/auth-stub dev      # serves on SB_AUTH_STUB_PORT
#   VITE_SB_AUTH_URL=/                             # shell -> browser Auth adapter
# Set SB_AUTH_STUB_PAT to a fine-grained repo PAT (contents:write on ONE repo) to
# have /mint hand back a token that reaches a real GitHub repo through the
# git-proxy. Deployed (Phase B): set VITE_SB_AUTH_URL to the Auth-service origin.
VITE_SB_AUTH_URL=/
SB_AUTH_STUB_PORT=8788
SB_AUTH_STUB_PAT=

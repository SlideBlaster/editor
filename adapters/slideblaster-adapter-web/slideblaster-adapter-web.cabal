cabal-version:      3.8
name:               slideblaster-adapter-web
version:            0.1.0.0
synopsis:           Narrow JSFFI host adapter for SlideBlaster WebAssembly
license:            BSD-3-Clause
build-type:         Simple

library
  exposed-modules:
      SlideBlaster.Adapter.Web
      SlideBlaster.Adapter.Web.Bytes
      SlideBlaster.Adapter.Web.HostCall
      SlideBlaster.Adapter.Web.Log
      SlideBlaster.Adapter.Web.Measure
      SlideBlaster.Adapter.Web.Port
      SlideBlaster.Adapter.Web.Storage
      SlideBlaster.Adapter.Web.String
  hs-source-dirs:      src
  build-depends:
      aeson >=2.1 && <3
    , base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , ghc-experimental
    , slideblaster-ports
    , slideblaster-protocol
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields
  if !os(wasi)
    buildable: False

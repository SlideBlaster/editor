cabal-version:      3.0
name:               slideblaster-deck
version:            0.1.0.0
synopsis:           Lossless provisional implicit-canvas deck trial
license:            NONE
build-type:         Simple
data-files:
    test/fixtures/demo.slide

library
  exposed-modules:
      SlideBlaster.Deck
      SlideBlaster.Deck.Container
      SlideBlaster.Deck.Edit
      SlideBlaster.Deck.Frontmatter
      SlideBlaster.Deck.Include
      SlideBlaster.Deck.Markdown
  hs-source-dirs:      src
  build-depends:
      base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.9
    , slideblaster-canvas
    , slideblaster-document
    , slideblaster-listing
    , slideblaster-presentation
    , slideblaster-source
    , slideblaster-syntax
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Werror
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-deck-tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:
      base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , slideblaster-canvas
    , slideblaster-deck
    , slideblaster-document
    , slideblaster-presentation
    , slideblaster-source
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Werror
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-deck-markdown-tests
  type:                exitcode-stdio-1.0
  main-is:             Markdown.hs
  hs-source-dirs:      test
  build-depends:
      base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , directory >=1.3 && <1.4
    , slideblaster-canvas
    , slideblaster-deck
    , slideblaster-document
    , slideblaster-source
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

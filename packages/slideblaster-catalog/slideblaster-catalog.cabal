cabal-version:      3.0
name:               slideblaster-catalog
version:            0.1.0.0
synopsis:           Validated shape and attributed stencil catalogs
license:            NONE
build-type:         Simple
data-files:
    data/drawio/catalog-v1.json
    THIRD_PARTY_NOTICES.md

library
  exposed-modules:
      SlideBlaster.Catalog
      SlideBlaster.Catalog.Curated
      SlideBlaster.Catalog.DrawIO
      SlideBlaster.Catalog.Model
      SlideBlaster.Catalog.Search
  hs-source-dirs:      src
  build-depends:
      aeson >=2.2 && <2.3
    , base >=4.20 && <5
    , bytestring >=0.12 && <0.13
    , containers >=0.6 && <0.9
    , scientific >=0.3 && <0.4
    , slideblaster-canvas
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-catalog-tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  other-modules:       Paths_slideblaster_catalog
  autogen-modules:     Paths_slideblaster_catalog
  build-depends:
      aeson >=2.2 && <2.3
    , base >=4.20 && <5
    , bytestring >=0.12 && <0.13
    , slideblaster-canvas
    , slideblaster-catalog
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

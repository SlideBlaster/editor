cabal-version:      3.0
name:               slideblaster-document
version:            0.1.0.0
synopsis:           Source-locked semantic document snapshots for SlideBlaster
license:            NONE
build-type:         Simple

library
  exposed-modules:
      SlideBlaster.Document
      SlideBlaster.Document.Diagnostic
      SlideBlaster.Document.Provenance
      SlideBlaster.Document.Snapshot
  hs-source-dirs:      src
  build-depends:
      base >=4.20 && <5
    , containers >=0.6 && <0.9
    , slideblaster-source
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-document-tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:
      base >=4.20 && <5
    , containers >=0.6 && <0.9
    , slideblaster-document
    , slideblaster-source
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

cabal-version:      3.0
name:               slideblaster-syntax
version:            0.1.0.0
synopsis:           Lossless mixed-dialect concrete syntax trees
license:            NONE
build-type:         Simple

library
  exposed-modules:
      SlideBlaster.Syntax.Fix
      SlideBlaster.Syntax.Number
      SlideBlaster.Syntax.Ast
      SlideBlaster.Syntax.Block
      SlideBlaster.Syntax.Overlay
      SlideBlaster.Syntax.Picture
      SlideBlaster.Syntax.Style
      SlideBlaster.Syntax.Surface
      SlideBlaster.Syntax.Colour
      SlideBlaster.Syntax.Command
      SlideBlaster.Syntax.Path
      SlideBlaster.Syntax.Printer
      SlideBlaster.Syntax.Range
      SlideBlaster.Syntax.Expand
      SlideBlaster.Syntax.Inline
      SlideBlaster.Syntax.Edit
      SlideBlaster.Syntax.Html.Reader
      SlideBlaster.Syntax.Markdown.Reader
      SlideBlaster.Syntax.Tex.Reader
  hs-source-dirs:      src
  build-depends:
      base >=4.20 && <5
    , containers >=0.6 && <0.9
    , megaparsec >=9.6 && <9.8
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-syntax-tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:
      base >=4.20 && <5
    , slideblaster-syntax
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-syntax-flow-tests
  type:                exitcode-stdio-1.0
  main-is:             Flow.hs
  hs-source-dirs:      test
  build-depends:
      base >=4.20 && <5
    , directory >=1.3 && <1.4
    , slideblaster-syntax
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

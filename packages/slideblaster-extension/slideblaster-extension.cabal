cabal-version:      3.0
name:               slideblaster-extension
version:            0.1.0.0
synopsis:           Extension slots, manifests, fingerprints and the TikZ request builder
license:            NONE
build-type:         Simple

common warnings
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

library
  import:              warnings
  exposed-modules:
      SlideBlaster.Extension
      SlideBlaster.Extension.Absence
      SlideBlaster.Extension.Base64
      SlideBlaster.Extension.Envelope
      SlideBlaster.Extension.Manifest
      SlideBlaster.Extension.Registry
      SlideBlaster.Extension.Request
      SlideBlaster.Extension.Sha256
      SlideBlaster.Extension.Slot
      SlideBlaster.Extension.Tikz
  hs-source-dirs:      src
  build-depends:
      aeson >=2.1 && <3
    , base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , scientific >=0.3 && <0.4
    , text >=2.0 && <2.2
    , vector >=0.13 && <0.14

test-suite slideblaster-extension-tests
  import:              warnings
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:
      aeson >=2.1 && <3
    , base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , slideblaster-extension
    , text >=2.0 && <2.2

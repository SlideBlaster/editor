cabal-version:      3.0
name:               slideblaster-source
version:            0.1.0.0
synopsis:           Byte-exact source snapshots and local edits for SlideBlaster
license:            NONE
build-type:         Simple

library
  exposed-modules:
      SlideBlaster.Source
      SlideBlaster.Source.Edit
      SlideBlaster.Source.Revision
      SlideBlaster.Source.Snapshot
      SlideBlaster.Source.Span
  hs-source-dirs:      src
  build-depends:
      base >=4.20 && <5
    , bytestring >=0.11 && <0.13
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-source-tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:
      base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , slideblaster-source
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

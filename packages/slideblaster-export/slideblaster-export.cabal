cabal-version:      3.0
name:               slideblaster-export
version:            0.1.0.0
synopsis:           Honest deterministic export planning for SlideBlaster
license:            NONE
build-type:         Simple

library
  exposed-modules:
      SlideBlaster.Export.Offline
      SlideBlaster.Export
      SlideBlaster.Export.Diagnostic
      SlideBlaster.Export.Rendered
  other-modules:
      SlideBlaster.Export.Internal.Html
      SlideBlaster.Export.Internal.Latex
      SlideBlaster.Export.Internal.LatexProject
      SlideBlaster.Export.Internal.Model
      SlideBlaster.Export.Internal.Report
      SlideBlaster.Export.Internal.Workspace
      SlideBlaster.Export.Types
  hs-source-dirs:      src
  build-depends:
      aeson >=2.1 && <3
    , base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.9
    , slideblaster-canvas
    , slideblaster-presentation
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Werror
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-export-tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:
      test
      src
  other-modules:
      SlideBlaster.Export
      SlideBlaster.Export.Diagnostic
      SlideBlaster.Export.Internal.Html
      SlideBlaster.Export.Internal.Latex
      SlideBlaster.Export.Internal.LatexProject
      SlideBlaster.Export.Internal.Model
      SlideBlaster.Export.Internal.Report
      SlideBlaster.Export.Internal.Workspace
      SlideBlaster.Export.Rendered
      SlideBlaster.Export.Types
  build-depends:
      base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.9
    , slideblaster-canvas
    , slideblaster-presentation
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Werror
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-export-offline-tests
  type:                exitcode-stdio-1.0
  main-is:             OfflineMain.hs
  hs-source-dirs:      test
  build-depends:
      aeson >=2.1 && <3
    , base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , slideblaster-export
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Werror

cabal-version:      3.0
name:               slideblaster-listing
version:            0.1.0.0
synopsis:           Code-listing model: language, highlight sets and per-step highlight specs
license:            NONE
build-type:         Simple

library
  exposed-modules:
      SlideBlaster.Listing
  hs-source-dirs:      src
  build-depends:
      base >=4.20 && <5
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

test-suite slideblaster-listing-tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:
      base >=4.20 && <5
    , slideblaster-listing
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields

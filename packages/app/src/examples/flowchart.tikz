\node[title] (t) at (8,8.3) {Flowchart};
\node[draw, rounded corners=10pt, fill=#dbeafe, minimum width=3, minimum height=1.2] (start) at (8,6.8) {Start};
\node[draw, fill=#eef2ff, minimum width=3.6, minimum height=1.2] (read) at (8,5) {Read input};
\node[draw, diamond, fill=#fef9c3, minimum width=3.8, minimum height=2.1] (check) at (8,2.9) {Valid?};
\node[draw, fill=#dcfce7, minimum width=3, minimum height=1.2] (proc) at (3.2,2.9) {Process};
\node[draw, fill=#fee2e2, minimum width=3.2, minimum height=1.2] (err) at (12.8,2.9) {Report error};
\node[draw, rounded corners=10pt, fill=#dbeafe, minimum width=3, minimum height=1.2] (done) at (3.2,0.7) {Done};
\node (yes) at (5.3,3.3) {yes};
\node (no) at (10.7,3.3) {no};
\draw[->] (start) -- (read);
\draw[->] (read) -- (check);
\draw[->] (check) -- (proc);
\draw[->] (check) -- (err);
\draw[->] (proc) -- (done);

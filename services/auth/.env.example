# SlideBlaster Auth service — dev secrets. Copy to `.env` (gitignored) and fill in.
# Source it before starting: `set -a; source .env; set +a; mix phx.server`

# From the GitHub App page (Settings → Developer settings → GitHub Apps):
GITHUB_APP_ID=4228880
GITHUB_CLIENT_ID=Iv23lisSDXA14QthWBtq
GITHUB_CLIENT_SECRET=          # "Generate a client secret" — paste here
APP_PRIVATE_KEY_PATH=./secrets/app.pem   # the downloaded .pem (also gitignored)

# Where the web shell runs (CORS + return_to allowlist):
WEB_SHELL_ORIGIN=http://localhost:5173

# Dev cookies: Lax + insecure suit the same-origin Vite-proxy path.
SECURE_COOKIES=false
COOKIE_SAMESITE=Lax

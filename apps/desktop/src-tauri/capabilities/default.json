{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The editor page (the app's own bundled page) may call the shell's commands and the dialog plugin.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-open-folder-dialog",
    "allow-open-presenter",
    "allow-debug-log",
    "allow-list-presentations",
    "allow-open-presentation",
    "allow-add-presentation",
    "allow-remove-presentation",
    "allow-open-pdf",
    "allow-project-list",
    "allow-project-read",
    "allow-project-write",
    "allow-project-cache-write",
    "allow-render-block",
    "allow-export-pdf"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The splash page and the sb serve page (loopback only) may call the shell's own commands and the dialog plugin.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-open-folder-dialog",
    "allow-shell-ready",
    "allow-open-presenter",
    "allow-debug-log",
    "allow-list-presentations",
    "allow-open-presentation",
    "allow-add-presentation",
    "allow-remove-presentation"
  ]
}

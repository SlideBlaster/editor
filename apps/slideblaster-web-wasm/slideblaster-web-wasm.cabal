cabal-version:      3.8
name:               slideblaster-web-wasm
version:            0.1.0.0
synopsis:           GHC Wasm reactor composition for SlideBlaster
license:            BSD-3-Clause
build-type:         Simple

library
  exposed-modules:
      SlideBlaster.Adapter.Web.Dispatch
      SlideBlaster.Adapter.Web.Product
      SlideBlaster.Adapter.Web.ProductV2
  hs-source-dirs:      src
  build-depends:
      aeson >=2.1 && <3
    , base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , slideblaster-app
    , slideblaster-adapter-web
    , slideblaster-product-runtime
    , slideblaster-protocol
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields
  if !os(wasi)
    buildable: False

executable slideblaster-web-wasm
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:
      base >=4.20 && <5
    , slideblaster-adapter-web
    , slideblaster-web-wasm
    , text >=2.0 && <2.2
  default-language:    GHC2024
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields
      -no-hs-main
      -optl-mexec-model=reactor
      -optl-Wl,--export=sb_start
      -optl-Wl,--export=sb_dispatch
      -optl-Wl,--export=sb_product_dispatch
      -optl-Wl,--export=sb_product_v2_dispatch
  if !os(wasi)
    buildable: False

{
  "name": "default",
  "title": "Default",
  "description": "Clean white theme with minimal styling",
  "aspect": [16, 9],
  "palette": {
    "background": "#ffffff",
    "ink": "#1a1a2e",
    "muted": "#555555",
    "accent": "#4a90d9",
    "link": "#4a90d9",
    "codeBackground": "#f1f5f9",
    "rule": "#dddddd",
    "block": { "bg": "#e8f0fb", "title": "#4a90d9" },
    "alert": { "bg": "#fdecea", "title": "#c0392b" }
  },
  "fonts": {
    "body": "'Segoe UI', system-ui, -apple-system, sans-serif",
    "mono": "'JetBrains Mono', 'Fira Code', ui-monospace, monospace",
    "sizes": { "title": 0.72, "subtitle": 0.45, "body": 0.4, "small": 0.3, "code": 0.3 }
  },
  "regions": {
    "title": { "x": 0.9, "y": 7.35, "w": 14.2, "h": 1.15 },
    "body": { "x": 0.9, "y": 1.1, "w": 14.2, "h": 5.95 },
    "footer": { "x": 0.9, "y": 0.25, "w": 14.2, "h": 0.55 },
    "safe": { "x": 0.5, "y": 0.4, "w": 15, "h": 8.2 }
  },
  "titleSlide": {
    "title": { "x": 1.6, "y": 4.7, "w": 12.8, "h": 1.5, "align": "center" },
    "subtitle": { "x": 1.6, "y": 3.7, "w": 12.8, "h": 0.8, "align": "center" },
    "authors": { "x": 1.6, "y": 2.4, "w": 12.8, "h": 0.6, "align": "center" },
    "institute": { "x": 1.6, "y": 1.7, "w": 12.8, "h": 0.5, "align": "center" },
    "date": { "x": 1.6, "y": 1.1, "w": 12.8, "h": 0.5, "align": "center" }
  },
  "furniture": [
    { "kind": "rule", "slides": "all", "x": 0, "y": 0, "w": 16, "h": 0.045, "fill": "accent" },
    { "kind": "page-number", "slides": "not-first", "x": 14.4, "y": 0.25, "w": 1, "h": 0.5, "align": "right" },
    { "kind": "footer-text", "slides": "not-first", "x": 0.9, "y": 0.25, "w": 10, "h": 0.5, "text": "{{title}}" }
  ],
  "prelude": "prelude.tex",
  "css": "theme.css"
}
